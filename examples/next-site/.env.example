# Server-only. None of these may reach the browser: never prefix them NEXT_PUBLIC_.
ZWINGD_API_URL=https://dev-api.zwingd.com
# The workspace's app address, exactly as the platform team gave it.
ZWINGD_APP_URL=https://app.example.org
ZWINGD_REALM=yourRealm
# The client secret for this website's origin (zsh_ + 64 hex), from the platform team.
ZWINGD_SESSION_CLIENT_SECRET=
# This website's origin, exactly as the platform team listed it.
ZWINGD_SITE_ORIGIN=https://www.example.org
# Local development on http://localhost only (refused when NODE_ENV=production).
ZWINGD_INSECURE_LOCAL_COOKIES=false
# Member checkout: the visitor's country for pricing, as a JSON map from the
# host's two-letter geo header to the workspace's master-data country ids,
# e.g. {"IN":"<24 hex>","US":"<24 hex>"}. Empty = no visitor country. The code
# step (EXAMPLE_VERIFY_EMAIL) needs one: without it the start of a buyer who is not an active member is refused.
ZWINGD_COUNTRY_IDS=
# Optional, kit #11: the app's page for one course, with :code in it (SCPMI:
# /communities/courses/:code). Empty = course links open /communities/learning.
ZWINGD_COURSE_PATH=
# Example only: show the code step before payment on the course page (a real
# site reads websiteCheckoutStatus.verifyEmail).
EXAMPLE_VERIFY_EMAIL=off
# Example only: the guest total the course page shows, in minor units (a real
# site reads the public guest quote). The code step re-quotes with the proof
# and goes straight to payment only when the total is unchanged.
EXAMPLE_GUEST_TOTAL_MINOR=9900
# Example only: that total's currency (ISO 4217). Without a valid total and
# currency the course page shows the guest stand-in, not the code step.
EXAMPLE_GUEST_CURRENCY=USD
