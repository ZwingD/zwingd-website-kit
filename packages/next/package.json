{
  "name": "@zwingd-ce/website-kit-next",
  "version": "0.1.1",
  "description": "Next.js App Router adapter of the Zwingd website kit: /session/* route handlers, server getMember, and an unstyled AccountButton.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@zwingd-ce/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "@zwingd-ce/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "@zwingd-ce/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test --test-force-exit --experimental-strip-types --conditions=@zwingd-ce/source --import ./test/tsx-loader.mjs 'test/**/*.test.ts'",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test && pnpm type-check"
  },
  "dependencies": {
    "@zwingd-ce/website-kit": "workspace:^"
  },
  "peerDependencies": {
    "next": ">=15.0.0 <17.0.0",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "happy-dom": "20.14.5",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "zwingd",
    "session",
    "nextjs",
    "app-router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwingD/zwingd-website-kit.git",
    "directory": "packages/next"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
